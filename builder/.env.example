# Secrets: server only. Never use NEXT_PUBLIC_ for these values.
HUMAN_WEBS_OPERATOR_TOKEN=
# Optional exact browser origin, e.g. http://localhost:3000
HUMAN_WEBS_APP_ORIGIN=
# Optional AI. Select a current ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# Optional publication, only after review and explicit approval in the UI.
HUMAN_WEBS_VERCEL_TOKEN=
HUMAN_WEBS_VERCEL_TEAM_ID=
# Optional private client repositories. Revisions are saved to separate branches.
HUMAN_WEBS_GITHUB_TOKEN=
